# Optional LLM reasoning provider. Deterministic training and evaluation still
# run when these credentials are absent; reasoning falls back to local text.
LLM_PROVIDER=gemini
LLM_MODE=live
LLM_MAX_TOKENS=700
LLM_FALLBACK_TIMEOUT_SECONDS=15
GEMINI_API_KEY=your-google-ai-studio-key-here
CREWAI_MODEL=gemini/gemini-3.8-flash
# Optional when both providers are configured; derived from CREWAI_MODEL otherwise.
# OPENROUTER_FALLBACK_MODEL=openrouter/google/gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini/gemini-3.8-flash
A2A_TASKS_URL=http://localhost:8080/a2a/tasks/send
A2A_BIND_HOST=127.0.0.1
A2A_BIND_PORT=8080
MLFLOW_UI_URL=http://127.0.0.1:5001
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=your-langfuse-project-id

# Optional OpenRouter alternative:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPEN_ROUTER_API_KEY is also accepted for compatibility.
# CREWAI_MODEL=openrouter/google/gemini-3.8-flash
