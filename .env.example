# Optional LLM reasoning provider. Deterministic training and evaluation still
# run when these credentials are absent; reasoning falls back to local text.
LLM_PROVIDER=gemini
LLM_MODE=live
# Gemini 3.x counts internal 'thinking' against this limit; 700 truncates JSON.
LLM_MAX_TOKENS=2048
LLM_FALLBACK_TIMEOUT_SECONDS=40
# Price of your model in USD per 1M tokens (from your provider's pricing page).
# Used only to estimate run cost; 0 means "not configured".
# Example: Gemini 3.5 Flash-Lite on Google AI Studio.
LLM_INPUT_COST_PER_1M=0.15
LLM_OUTPUT_COST_PER_1M=1.25
GEMINI_API_KEY=your-google-ai-studio-key-here
CREWAI_MODEL=gemini/gemini-3.5-flash-lite
# Optional: only for Gemini models that accept a thinking budget.
# GEMINI_THINKING_BUDGET=0
# Optional when both providers are configured; derived from CREWAI_MODEL otherwise.
# OPENROUTER_FALLBACK_MODEL=openrouter/google/gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
# Base URL of the Google ADK agent (A2A Agent Card is served under /.well-known/)
A2A_AGENT_URL=http://localhost:8080
A2A_BIND_HOST=127.0.0.1
A2A_BIND_PORT=8080
MLFLOW_UI_URL=http://127.0.0.1:5055
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=your-langfuse-project-id

# Optional OpenRouter alternative:
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPEN_ROUTER_API_KEY is also accepted for compatibility.
# CREWAI_MODEL=openrouter/google/gemini-3.5-flash-lite

# Keep CrewAI from pausing on its interactive cloud-trace prompt.
CREWAI_TRACING_ENABLED=false

# --- Efficiency -------------------------------------------------------------
# Providers tried in order after the primary, each ONCE (no retry storms).
# ollama/<model> runs locally via Ollama: free, private, no quota.
LLM_FALLBACK_CHAIN=ollama/qwen2.5-coder:latest,openrouter/google/gemini-3.5-flash-lite
# Narrative-only text (the run summary) can use the free local model.
LLM_NARRATIVE_MODEL=ollama/qwen2.5-coder:latest
# OLLAMA_HOST=http://localhost:11434
# Reuse identical, already-validated decisions (labelled "cache" everywhere).
# Set to off when you want every decision made live (e.g. a final demo).
LLM_CACHE=on
# Optional per-provider prices (USD per 1M tokens); local Ollama is always $0.
# OPENROUTER_INPUT_COST_PER_1M=0.15
# OPENROUTER_OUTPUT_COST_PER_1M=1.25
